' Container Diagram

@startuml C4_Level2_Container_Revised
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container Diagram - WAHrden IAM & Governance Architecture

Person(users, "WAH Ecosystem Actors", "Central Administrators, Facility Administrators, and WAH Service Users.")
System_Ext(participating_services, "Participating WAH Services", "WAH-for-Clinics, WAH-for-Hospitals, WAH-for-PrimaryCare, and WAH4Interop.")

System_Boundary(wahrden_boundary, "WAHrden Platform System Boundary") {
    Container(user_portal, "WAH User Access Portal", "Single Page Application (React / Vite)", "Presents participating service selection, authentication challenges, self-service credential changes, and own-profile updates (UC-ASS-01 to 03, UC-IAL-03).")
    Container(admin_portal, "WAHrden Central Governance Console", "Single Page Application (React / Vite)", "Interface for Central & Facility Admins to manage RBAC, facility onboarding, request approvals, and audit log inspection (UC-AGA, UC-FMG, UC-OSO).")
    
    Container(api_gateway, "API Gateway / Reverse Proxy", "Nginx / Traefik", "Handles TLS termination, path routing, rate limiting, and request header sanitization.")

    Container(auth_service, "Authentication & Session Service", "NestJS / Node.js", "Handles credential verification, MFA challenge flow, token lifecycle, and administrative session termination (UC-ASS-01 to 04).")
    Container(identity_service, "Identity & Account Lifecycle Service", "NestJS / Node.js", "Manages user profiles, account state transitions (Active, Inactive, Deactivated), and background 51-day inactivity evaluations (UC-IAL-01 to 03).")
    Container(pdp_service, "Access Governance & PDP Service", "NestJS / Node.js", "Executes Policy Decision Point (PDP) checks (UC-AGA-07), request governance review pipelines (UC-AGA-03 to 06), and facility module policies (UC-FMG-01 to 05).")
    Container(audit_service, "Operational & Oversight Service", "NestJS / Node.js", "Ingests security events, queries administrative actions, and generates operational reports (UC-OSO-01, UC-OSO-02).")

    ContainerDb(redis_cache, "Active Session & Token Cache", "Redis", "Maintains active user session tokens, rate-limit counters, and revoked token blacklists (UC-ASS-04).")
    ContainerDb(wahrden_db, "WAHrden Primary RDBMS", "PostgreSQL", "Stores user identities, credentials, recovery methods, facilities, roles, permissions, access requests, and module configs.")
    ContainerDb(audit_db, "Audit & Security Event Store", "PostgreSQL", "Dedicated storage for immutable audit trail records, administrative reviews, and PDP decisions.")
}

' User Ingress
Rel(users, user_portal, "Navigates to login or manage own credentials", "HTTPS")
Rel(users, admin_portal, "Conducts administrative workflows", "HTTPS")

Rel(user_portal, api_gateway, "Submits user credentials & profile changes", "HTTPS / JSON")
Rel(admin_portal, api_gateway, "Submits governance & audit queries", "HTTPS / JSON")

' Gateway Routing
Rel(api_gateway, auth_service, "Routes /api/v1/auth/* & /api/v1/sessions/*", "HTTP / REST")
Rel(api_gateway, identity_service, "Routes /api/v1/identities/* & /api/v1/profile/*", "HTTP / REST")
Rel(api_gateway, pdp_service, "Routes /api/v1/pdp/*, /api/v1/requests/*, /api/v1/facilities/*", "HTTP / REST")
Rel(api_gateway, audit_service, "Routes /api/v1/oversight/* & /api/v1/reports/*", "HTTP / REST")

' External Service PDP Checks
Rel(participating_services, api_gateway, "Calls authorization evaluation (UC-AGA-07) and validates session token", "HTTPS / JSON")

' Service to Storage Interconnections
Rel(auth_service, redis_cache, "Writes and invalidates active sessions (UC-ASS-04)", "Redis Protocol")
Rel(auth_service, wahrden_db, "Validates credentials & updates password state", "TypeORM / SQL")
Rel(identity_service, wahrden_db, "CRUD on users, status changes, and inactivity flag", "TypeORM / SQL")
Rel(pdp_service, wahrden_db, "Evaluates user-facility roles, module configs, and request records", "TypeORM / SQL")

' Centralized Audit Trail Ingestion
Rel(auth_service, audit_service, "Dispatches auth & session termination events", "Internal In-Memory / EventBus")
Rel(pdp_service, audit_service, "Dispatches PDP Authorized/Denied & review decisions", "Internal In-Memory / EventBus")
Rel(identity_service, audit_service, "Dispatches account status & profile modification events", "Internal In-Memory / EventBus")
Rel(audit_service, audit_db, "Persists immutable audit log rows (audit_logs table)", "TypeORM / SQL")

@enduml
