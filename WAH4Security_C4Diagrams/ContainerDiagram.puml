' Container Diagram

@startuml C4_Level2_Container_OpenHIM_OpenSource
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container Diagram - WAHrden Platform Architecture (WAH4Security Scope)

Person(all_users, "All Users & Staff", "Central Admin, Facility Admin, Doctors, Nurses, and MedTechs.")

' ==============================================================================
' WAHRDEN PLATFORM BOUNDARY (WAH4SECURITY)
' ==============================================================================
System_Boundary(wahrden_boundary, "WAHrden Platform Boundary (WAH4Security Scope)") {
    
    ' Web Portals Developed by Us
    Container(auth_portal, "WAH User Access Portal", "React / Vite, TypeScript", "Primary front door developed by our team. Central login page (SSO), MFA challenges, cookie issuance, and account recovery (UC-ASS-01..03, UC-IAL-03).")
    Container(admin_console, "WAHrden Governance Admin Console", "React / Vite, TypeScript", "Admin console developed by our team for role modeling, facility onboarding, 2-tier approval queues, and audit inspection.")

    ' Open-Source Tool Deployed & Configured by Us
    Container(openhim_gateway, "OpenHIM Gateway & Mediator", "Open-Source OpenHIM Core / Node.js\n(Configured & Deployed by Us)", "Pre-existing open-source tool operated by WAH4Security. Acts as reverse-proxy, transaction interceptor, and Policy Enforcement Point (PEP). Enforces TLS and routes requests to our PDP.")

    ' Core Backend Microservices Developed by Us
    Container(auth_service, "Authentication & Session Service", "NestJS / Node.js", "Developed by our team. Validates credentials, issues session cookies/JWTs, and enforces admin session termination (UC-ASS-01..04).")
    Container(identity_service, "Identity & Account Lifecycle Service", "NestJS / Node.js", "Developed by our team. Manages user identities, mandatory baseline roles, lifecycle states, and the 51-day inactivity background worker (UC-IAL-01, 02).")
    Container(pdp_service, "Access Governance & PDP Service", "NestJS / Node.js", "Developed by our team. Centralized Policy Decision Point (PDP). Evaluates user assignments, roles, module availability, and two-tier access requests (UC-AGA, UC-FMG).")
    Container(oversight_service, "Operational & Security Oversight Service", "NestJS / Node.js", "Developed by our team. Aggregates security telemetry, produces audit dashboards, and compiles compliance reports (UC-OSO-01, 02).")

    ' Storage & Cache
    ContainerDb(redis_cache, "Active Session & Token Cache", "Redis", "Stores active user sessions, centralized cookie tokens, revocation blocklists, and rate-limiting flags.")
    ContainerDb(wahrden_db, "WAHrden Primary RDBMS", "PostgreSQL (3NF)", "Stores user identities, credentials, facility profiles, roles, permissions, and module configurations.")
    ContainerDb(audit_db, "Audit & Security Event Store", "PostgreSQL", "Append-only storage for immutable audit logs, administrative approvals, and runtime PDP decisions.")
}

' ==============================================================================
' PARTICIPATING WAH PLATFORM TEAMS
' ==============================================================================
System_Ext(wah4clinic, "WAH4Clinic", "Participating outpatient EMR service.")
System_Ext(wah4hospital, "WAH4Hospital", "Participating inpatient hospital service.")
System_Ext(wah4interop, "WAH4Interoperability", "Partner team coordinating FHIR transformation and data exchange pipelines.")
System_Ext(external_agencies, "External Health Agencies", "PhilHealth e-Claims and National Health Registries.")

' ==============================================================================
' INTERACTIONS
' ==============================================================================

' Ingress
Rel(all_users, auth_portal, "1. Accesses central login page & signs in", "HTTPS / Web Browser")
Rel(all_users, admin_console, "Accesses administrative governance workflows", "HTTPS / Web Browser")

Rel(auth_portal, openhim_gateway, "Submits credentials, profile updates, and app requests", "HTTPS / JSON")
Rel(admin_console, openhim_gateway, "Submits governance configurations & audit queries", "HTTPS / JSON")

' OpenHIM Gateway Internal Dispatch
Rel(openhim_gateway, auth_service, "Routes /auth/* and session validation", "HTTP / Internal")
Rel(openhim_gateway, identity_service, "Routes /identities/* and account lifecycle", "HTTP / Internal")
Rel(openhim_gateway, pdp_service, "Dispatches authorization evaluation (POST /pdp/evaluate)", "HTTP / Internal")
Rel(openhim_gateway, oversight_service, "Dispatches security telemetry & audit events", "HTTP / Internal")

' Shared SSO Session to Participating Apps
Rel(auth_portal, wah4clinic, "2. Redirects authenticated worker (Session cookie recognized)", "HTTPS / Browser Redirect")
Rel(auth_portal, wah4hospital, "2. Redirects authenticated worker (Session cookie recognized)", "HTTPS / Browser Redirect")

' Participating Teams Transact via OpenHIM Gateway
Rel(wah4clinic, openhim_gateway, "3. Submits clinical requests & runtime PDP evaluation checks", "HTTPS / REST")
Rel(wah4hospital, openhim_gateway, "3. Submits admission transactions & PDP evaluation checks", "HTTPS / REST")
Rel(wah4interop, openhim_gateway, "3. Routes data pipelines through OpenHIM mediator", "HTTPS / REST")

' Outbound Dispatch
Rel(openhim_gateway, external_agencies, "Forwards authorized claims & registry data", "mTLS / HTTPS")

' Database Connections
Rel(auth_service, redis_cache, "Reads/writes active sessions & cookie revocation flags", "Redis Protocol")
Rel(auth_service, wahrden_db, "Validates credentials & password states", "TypeORM / SQL")
Rel(identity_service, wahrden_db, "Reads/updates user statuses & last login timestamps", "TypeORM / SQL")
Rel(pdp_service, wahrden_db, "Queries facility assignments, roles, and module licenses", "TypeORM / SQL")

' Centralized Immutable Logging
Rel(auth_service, audit_db, "Writes login, logout, and termination records", "SQL")
Rel(pdp_service, audit_db, "Writes PDP decisions and request review histories", "SQL")
Rel(oversight_service, audit_db, "Queries audit logs for compliance reports", "SQL")

@enduml
