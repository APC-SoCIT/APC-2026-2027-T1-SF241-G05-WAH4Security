' System Context Diagram

@startuml C4_Level1_System_Context_OpenHIM_OpenSource
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title System Context Diagram - WAH Enterprise (WAHrden Top-Level Gateway)

' ==============================================================================
' ACTORS
' ==============================================================================
Person(central_admin, "WAH Central Administrator", "Combined administrative authority & employee. Governs identities, roles, facility onboarding, and system audits.")
Person(facility_admin, "Facility Administrator", "Scoped local administrator. Submits user onboarding, access changes, and module change requests.")
Person(service_user, "WAH Service User", "Healthcare personnel (Doctors, Nurses, MedTechs) who authenticate via SSO, update profile details, and manage credentials.")

' ==============================================================================
' TOP-LEVEL SYSTEM: WAHRDEN (WAH4SECURITY)
' ==============================================================================
System(wahrden, "WAHrden Platform\n[WAH4Security - Developed by Us]\n(Operates Deployed OpenHIM Gateway)", "Central SSO trust authority and Policy Decision Point (PDP). Deploys and manages OpenHIM as its open-source API gateway to intercept requests, enforce session cookies, evaluate RBAC/module rules, and log security audits.")

' ==============================================================================
' PARTICIPATING ENTERPRISE TEAMS & SERVICES
' ==============================================================================
Enterprise_Boundary(wah_ecosystem, "WAH Healthcare Ecosystem") {
    System_Ext(wah4clinic, "WAH4Clinic", "Participating outpatient EMR service handling checkups, triage, and pharmacy.")
    System_Ext(wah4hospital, "WAH4Hospital", "Participating inpatient hospital service managing admissions and bed wards.")
    System_Ext(wah4interop, "WAH4Interoperability", "Partner team handling health data standards, FHIR mappings, and payload formats.")
}

System_Ext(external_agencies, "External Health Agencies", "PhilHealth e-Claims, DOH Registries, and National Health Repositories.")

' ==============================================================================
' INTERACTIONS
' ==============================================================================

' 1. SSO INGRESS
Rel(central_admin, wahrden, "Administers enterprise accounts, facilities, roles, and audits", "HTTPS / Browser")
Rel(facility_admin, wahrden, "Authenticates & submits facility onboarding/access proposals", "HTTPS / Browser")
Rel(service_user, wahrden, "1. Signs in via Central SSO portal (obtains secure session cookie/JWT)", "HTTPS / OIDC")

' 2. DOWNSTREAM ACCESS
Rel(service_user, wah4clinic, "2. Accesses outpatient consults (Shared SSO session recognized)", "HTTPS")
Rel(service_user, wah4hospital, "2. Accesses inpatient rounds (Shared SSO session recognized)", "HTTPS")

' 3. CLINICAL CALLS VIA DEPLOYED OPENHIM GATEWAY
Rel(wah4clinic, wahrden, "Routes clinical API transactions & PDP check requests (UC-AGA-07) through OpenHIM", "HTTPS / REST")
Rel(wah4hospital, wahrden, "Routes inpatient transactions & PDP check requests (UC-AGA-07) through OpenHIM", "HTTPS / REST")
Rel(wah4interop, wahrden, "Exchanges interoperability payloads mediated via OpenHIM", "HTTPS / REST")

' 4. OUTBOUND DISPATCH
Rel(wahrden, external_agencies, "Dispatches authorized FHIR payloads & e-Claims via OpenHIM", "mTLS / HTTPS")

@enduml
