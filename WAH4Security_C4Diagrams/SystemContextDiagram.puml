' System Context Diagram

@startuml C4_Level1_System_Context_Revised
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title System Context Diagram - WAHrden Platform (Security & Central Governance)

Person(central_admin, "WAH Central Administrator", "Centrally manages identities, account statuses, RBAC models, healthcare facilities, module governance, and oversight reports.")
Person(facility_admin, "Facility Administrator", "Administers facility-scoped operations; submits user onboarding, access change, and facility module change requests.")
Person(service_user, "WAH Service User", "Healthcare personnel (Doctors, Nurses, Clinic Staff) accessing participating services.")

Enterprise_Boundary(wah_ecosystem, "Wireless Access for Health (WAH) Ecosystem") {
    System(wahrden, "WAHrden Platform\n[Security & Central IAM]", "Centralized governance authority providing user identity lifecycle, authentication, session security, centralized RBAC, facility scoping, and policy decision enforcement (PDP).")

    System_Ext(wah4clinic, "WAH-for-Clinics\n(Participating Service)", "Clinic EMR handling patient records, consultations, diagnostics, and local facility operations.")
    System_Ext(wah4hospital, "WAH-for-Hospitals\n(Participating Service)", "Hospital information management system managing in-patient care, admissions, and ward workflows.")
    System_Ext(wah4pc, "WAH-for-PrimaryCare\n(Participating Service)", "Primary care information system managing community consultations, vital signs, and referrals.")
    System_Ext(wah4interop, "WAH4Interop / OpenHIM\n(Mediator Service)", "Health Information Mediator routing transactions, PhilHealth e-Claims, and HIE integrations.")
}

System_Ext(external_systems, "External Health Agencies", "PhilHealth servers, DOH registries, and National Health Repositories.")

' User Interactions with WAHrden
Rel(service_user, wahrden, "Authenticates via central portal, updates own profile, recovers credentials\n(UC-ASS-01 to 03, UC-IAL-03)", "HTTPS / Web Browser")
Rel(central_admin, wahrden, "Administers identities, grants facility access, configures modules, reviews audit trails\n(UC-IAL-01/02, UC-AGA-01/02/04/06, UC-FMG-01/03/05, UC-OSO-01/02)", "HTTPS / Web Browser")
Rel(facility_admin, wahrden, "Submits scoped onboarding, access modification, and module change requests\n(UC-AGA-03/05, UC-FMG-04)", "HTTPS / Web Browser")

' User Interactions with Participating Services
Rel(service_user, wah4clinic, "Logs into and operates clinical workflows", "HTTPS")
Rel(service_user, wah4hospital, "Logs into and operates in-patient workflows", "HTTPS")
Rel(service_user, wah4pc, "Logs into and operates primary health workflows", "HTTPS")

' Participating Services Auth Checks with WAHrden
Rel(wah4clinic, wahrden, "Requests authorization evaluation & verifies active session\n(UC-AGA-07, UC-ASS-03)", "HTTPS / JSON API")
Rel(wah4hospital, wahrden, "Requests authorization evaluation & verifies active session\n(UC-AGA-07, UC-ASS-03)", "HTTPS / JSON API")
Rel(wah4pc, wahrden, "Requests authorization evaluation & verifies active session\n(UC-AGA-07, UC-ASS-03)", "HTTPS / JSON API")
Rel(wah4interop, wahrden, "Verifies service client tokens & system authority", "HTTPS / JSON API")

' Interop & External Transactions
Rel(wah4clinic, wah4interop, "Dispatches insurance claims & diagnostic payloads", "HTTPS / REST")
Rel(wah4hospital, wah4interop, "Dispatches admission data & billing claims", "HTTPS / REST")
Rel(wah4pc, wah4interop, "Dispatches community registry data", "HTTPS / REST")
Rel(wah4interop, external_systems, "Exchanges transactions via FHIR & PhilHealth standards", "mTLS / HTTPS")

@enduml
