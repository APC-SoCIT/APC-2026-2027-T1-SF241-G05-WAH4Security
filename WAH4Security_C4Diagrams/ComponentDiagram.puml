' Component Diagram

@startuml C4_Level3_Component_WAHrden_Backend
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component Diagram - WAHrden Core Backend Application (NestJS Scope)

' ==============================================================================
' EXTERNAL CONTAINERS (BOUND TO THE BACKEND)
' ==============================================================================
Container(user_portal, "WAH User Access Portal", "React / Vite", "Central Login, credential update & profile self-service.")
Container(admin_console, "Governance Admin Console", "React / Vite", "Maker-Checker approval queue, facility & role config.")
Container(openhim_gateway, "OpenHIM Gateway & Mediator", "OpenHIM / Node.js (Open-Source)", "Deployed PEP gateway routing API traffic & enforcing TLS.")

ContainerDb(redis_cache, "Active Session & Token Cache", "Redis", "Active sessions, cookies, token revocation blocklists.")
ContainerDb(wahrden_db, "WAHrden Primary RDBMS", "PostgreSQL (3NF)", "User identities, facility configs, roles, permissions.")
ContainerDb(audit_db, "Audit & Security Event Store", "PostgreSQL", "Append-only table storing immutable security audit trails.")

' ==============================================================================
' WAHRDEN BACKEND CONTAINER BOUNDARY
' ==============================================================================
Container_Boundary(backend_app, "WAHrden Core Backend Application (NestJS / TypeScript)") {

    ' Ingress Security & Routing Middleware
    Component(auth_guard, "SSO Session Guard & Cookie Parser", "NestJS Guard", "Validates incoming HTTP-only cookies/JWTs against Redis blacklist before routing.")
    Component(audit_interceptor, "Audit Logging Interceptor", "NestJS Interceptor", "Asynchronously captures caller identity, IP, action, timestamp, and dispatches to Audit Store.")

    ' Module 1: Identity & Account Lifecycle (IAL)
    package "Identity & Account Lifecycle (IAL)" {
        Component(ial_controller, "Identity Controller", "NestJS Controller", "Endpoints for account provisioning, status updates, and profile maintenance (UC-IAL-01..03).")
        Component(ial_service, "Identity & Account Service", "NestJS Injectable", "Enforces identity conflict checks, account status transitions, and user profile validations.")
        Component(inactivity_worker, "Inactivity Deprivileging Worker", "NestJS Cron / Task Scheduler", "Scheduled batch job running daily at 00:00 UTC to set accounts idle for >= 51 days to Inactive (UC-IAL-02).")
    }

    ' Module 2: Authentication & Session Security (ASS)
    package "Authentication & Session Security (ASS)" {
        Component(ass_controller, "Auth & Session Controller", "NestJS Controller", "Endpoints for login, SSO cookie exchange, password recovery, and admin session kill-switch (UC-ASS-01..04).")
        Component(ass_service, "Auth & Session Engine", "NestJS Injectable", "Handles argon2 password hashing, recovery token verification, session lifecycle, and session invalidation cascades.")
    }

    ' Module 3: Access Governance & Authorization (AGA)
    package "Access Governance & Authorization (AGA)" {
        Component(pdp_controller, "PDP & Access Governance Controller", "NestJS Controller", "Endpoints for role config, Maker-Checker requests, and runtime policy decisions (UC-AGA-01..07).")
        Component(request_workflow_service, "Maker-Checker Workflow Engine", "NestJS Injectable", "Manages 2-tier approval workflows (PENDING -> APPROVED / MODIFIED / REJECTED) for onboarding & access change requests (UC-AGA-03..06).")
        Component(pdp_engine, "Policy Decision Point (PDP) Engine", "NestJS Injectable", "4-Stage live evaluation pipeline: checks account status, facility assignment, Doctor vs Nurse role permissions, and active module licenses (UC-AGA-07).")
    }

    ' Module 4: Facility & Module Governance (FMG)
    package "Facility & Module Governance (FMG)" {
        Component(fmg_controller, "Facility & Module Controller", "NestJS Controller", "Endpoints for hospital/clinic onboarding, facility profiles, and module change queues (UC-FMG-01..05).")
        Component(fmg_service, "Facility & Module Service", "NestJS Injectable", "Enforces facility code uniqueness, per-facility module toggling, and module request adjudication.")
    }

    ' Module 5: Operational & Security Oversight (OSO)
    package "Operational & Security Oversight (OSO)" {
        Component(oso_controller, "Oversight & Reporting Controller", "NestJS Controller", "Endpoints for telemetry dashboards and compliance report export (UC-OSO-01..02).")
        Component(oso_service, "Operational & Report Generator", "NestJS Injectable", "Compiles system audit events, generates structured tabular compliance views, and formats signed PDF/CSV exports.")
    }
}

' ==============================================================================
' COMPONENT INTERACTIONS & DATA FLOWS
' ==============================================================================

' Ingress from Gateway and Portals through Guards
Rel(openhim_gateway, auth_guard, "Forwards API requests & clinical authz checks", "HTTP / Internal")
Rel(user_portal, auth_guard, "Submits login & self-service actions", "HTTPS / JSON")
Rel(admin_console, auth_guard, "Submits admin configurations & reviews", "HTTPS / JSON")

Rel(auth_guard, ass_controller, "Routes /auth/*", "")
Rel(auth_guard, ial_controller, "Routes /identities/*", "")
Rel(auth_guard, pdp_controller, "Routes /pdp/* & /governance/*", "")
Rel(auth_guard, fmg_controller, "Routes /facilities/*", "")
Rel(auth_guard, oso_controller, "Routes /oversight/*", "")

' Controller to Service Bindings
Rel(ass_controller, ass_service, "Invokes auth logic", "")
Rel(ial_controller, ial_service, "Invokes identity management", "")
Rel(pdp_controller, request_workflow_service, "Invokes request queues", "")
Rel(pdp_controller, pdp_engine, "Invokes runtime evaluation (UC-AGA-07)", "")
Rel(fmg_controller, fmg_service, "Invokes facility/module rules", "")
Rel(oso_controller, oso_service, "Invokes report generation", "")

' Internal Service-to-Service Invocations
Rel(inactivity_worker, ial_service, "Triggers 51-day inactivity updates (UC-IAL-02)", "")
Rel(ial_service, ass_service, "Triggers session purge when account deactivated (UC-ASS-04)", "")
Rel(request_workflow_service, ial_service, "Triggers account creation on approved onboarding (UC-AGA-04)", "")
Rel(pdp_engine, fmg_service, "Verifies facility module is active (Stage 4)", "")

' Interceptor & Audit Stream
Rel(backend_app, audit_interceptor, "Intercepts completed operations", "")
Rel(audit_interceptor, audit_db, "Writes tamper-proof audit records", "SQL")

' Database & Cache Connectors
Rel(ass_service, redis_cache, "Validates/stores active tokens & cookies", "Redis Protocol")
Rel(ass_service, wahrden_db, "Queries password & recovery data", "TypeORM")
Rel(ial_service, wahrden_db, "Persists user identities", "TypeORM")
Rel(request_workflow_service, wahrden_db, "Persists pending requests & assignments", "TypeORM")
Rel(pdp_engine, wahrden_db, "Reads roles, permissions, facility assignments", "TypeORM")
Rel(fmg_service, wahrden_db, "Persists facility profiles & module configs", "TypeORM")
Rel(oso_service, audit_db, "Queries audit logs for tabular reports", "SQL")

@enduml
