' Core Platform Relationships
'========================
 
UC01 .> UC09 : <<include>>
UC01 .> UC10 : <<include>>
 
UC02 .> UC09 : <<include>>
UC03 .> UC09 : <<include>>
UC04 .> UC09 : <<include>>
UC05 .> UC09 : <<include>>
UC06 .> UC09 : <<include>>
UC07 .> UC09 : <<include>>
UC08 .> UC09 : <<include>>
 
UC08 .> UC01 : <<include>>
 
